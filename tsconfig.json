{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts", ".storybook/**/*.ts", ".storybook/**/*.tsx"],
  "exclude": [
    "node_modules",
    "src/lib/auth",
    "src/lib/app-data",
    "src/lib/multiplayer",
    "src/lib/db.ts",
    "src/lib/env.server.ts",
    "src/lib/error-component.tsx"
  ]
}
